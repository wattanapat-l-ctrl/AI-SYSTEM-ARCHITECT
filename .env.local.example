# ---------------------------------------------------------------------------
# Copy to .env.local and fill in the values from your Supabase project.
#   Project settings -> API
#   anon / publishable key  -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   service_role / secret key -> SUPABASE_SECRET_KEY   (server side only)
# ---------------------------------------------------------------------------

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://cwlbykkdtcqeznbwarlq.supabase.co

# Public key. Safe to expose to the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key with RLS bypass. NEVER prefix this with NEXT_PUBLIC_ and never
# commit it. Only used for auth.admin calls (member invites).
SUPABASE_SECRET_KEY=

# Optional. Without it the AI Review module runs its built-in rules analyzer.
# OPENAI_API_KEY=
